{
  "name": "ranktrail",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "题迹 RankTrail — dk_qwq 的算法竞赛榜单回放与 VP 工具",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "build:single": "vite build --config vite.single.config.ts && node scripts/inline-single.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:team": "node scripts/verify-team.mjs",
    "verify:xcpcio": "node scripts/verify-xcpcio.mjs",
    "verify:single": "node scripts/verify-single.mjs",
    "verify:background": "node scripts/verify-background.mjs",
    "verify:board": "node scripts/verify-board-layout.mjs",
    "verify:responsive": "node scripts/verify-responsive.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/saira-condensed": "^5.2.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "dk_qwq",
  "homepage": "https://dk-qwq.github.io/ranktrail/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dk-qwq/ranktrail.git"
  },
  "bugs": {
    "url": "https://github.com/dk-qwq/ranktrail/issues"
  },
  "packageManager": "pnpm@11.23.0"
}
